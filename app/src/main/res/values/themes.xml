<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OzinMusic" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/ozin_background</item>
        <item name="android:navigationBarColor">@color/ozin_background</item>
        <item name="android:windowBackground">@color/ozin_background</item>
    </style>

    <style name="Theme.OzinMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ozin_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.OzinMusic</item>
    </style>
</resources>
